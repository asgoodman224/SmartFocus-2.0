<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: allows plain http:// so the phone can reach a development server on a laptop
  (e.g. http://192.168.1.20:3000). Release builds only allow https.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
