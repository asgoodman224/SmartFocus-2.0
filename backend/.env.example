# Copy to `.env` and adjust. All settings are optional; see src/config.js.
PORT=3000
SESSION_DAYS=90
# Browser origins allowed to call the API (comma-separated), for `expo start --web`.
CORS_ORIGINS=http://localhost:8081
# Development only: sign in as demo@smartfocus.dev / smartfocus-demo.
DEMO_ACCOUNT=true

# PostgreSQL. Leave unset to keep data in memory (lost when the server stops).
# The tables are created on start; see src/store/schema.sql.
# DATABASE_URL=postgres://user:password@localhost:5432/smartfocus
# Set to true for hosted databases that require SSL.
# DATABASE_SSL=false
