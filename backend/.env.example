# Copy to `.env` and adjust. All settings are optional; see src/config.js.
PORT=3000
SESSION_DAYS=90
# Browser origins allowed to call the API (comma-separated), for `expo start --web`.
CORS_ORIGINS=http://localhost:8081
# Development only: sign in as demo@smartfocus.dev / smartfocus-demo.
DEMO_ACCOUNT=true

# Database. Leave all of these unset to keep data in memory (lost when the
# server stops). The database and tables are created on start.
#
# MySQL (the team database), by parts. Put the password in single quotes if it
# has #, $, quotes or spaces in it.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD='your password'
# DB_NAME=smartfocus
#
# Or one URL instead: postgres://user:password@host:5432/smartfocus or
# mysql://user:password@host:3306/smartfocus (URL-encode special characters).
# DATABASE_URL=
# Set to true for hosted databases that require SSL.
# DATABASE_SSL=false
