# Copy to `.env` and adjust. All settings are optional; see src/config.js.
PORT=3000
SESSION_DAYS=90
# Browser origins allowed to call the API (comma-separated), for `expo start --web`.
CORS_ORIGINS=http://localhost:8081
# Development only: sign in as demo@smartfocus.dev / smartfocus-demo.
DEMO_ACCOUNT=true

# MySQL, for the database-backed store (not wired up yet; see src/store/index.js).
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=smartfocus
